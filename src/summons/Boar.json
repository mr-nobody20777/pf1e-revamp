ormula":"","preparedOffsetFormula":""},"spell9":{"castPerDayOffsetFormula":"","preparedOffsetFormula":""}},"spellSlotAbilityBonusFormula":"","domainSlotValue":1}}},"cmb":{}},"details":{"height":"","weight":"","gender":"","deity":"","age":"","alignment":"tn","biography":{"value":""},"bonusFeatFormula":"","bonusSkillRankFormula":"","carryCapacity":{"bonus":{"user":0},"multiplier":{"base":1,"user":0}},"notes":{"value":"<div style=\"margin-top:15px;margin-bottom:5px;text-align:center;font-size:1em;font-weight:900\"><p>sbc | Generated with version 6.0.3 on November 19, 2026</p></div><hr /><div class=\"statblockContainer\" style=\"margin-top:15px\"><p></p><div class=\"sbcStatBlock\"><hr class=\"sbcBorder\" /><div style=\"padding:5px\"><h1>Boar <ul class=\"sbcSlashList\">   </ul></h1>  <hr /><div class=\"sbcSection\" data-content=\"base\"> <strong>Source</strong> PFRPG Bestiary<br /> <strong>XP</strong> 600<br />     <br /> N  Medium  Animal  <ul class=\"sbcCommaList sbcParensWrappedList\">    </ul><br /><ul class=\"sbcSemicolonList\"><li><strong>Init</strong>  +0</li>  <li><strong>Senses</strong><ul class=\"sbcCommaList\" data-content=\"senses\">  <li>Low-light</li>  <li>Scent 0 ft</li>  </ul></li>   <span><strong>Perception</strong> +6</span>  </ul><br />  </div><div class=\"sbcSection\" data-content=\"defense\"><h4>Defense</h4><hr /><ul class=\"sbcCommaList\"><li><strong>AC</strong> 14</li><li><strong>Touch</strong> 10</li><li><strong>Flat-footed</strong> 14</li></ul>  <ul class=\"sbcParensWrappedList sbcCommaList\" data-group=\"armor\">  <li>+4 Natural</li>  </ul>  <br /><ul class=\"sbcSemicolonList\"><li><strong>Hit Points</strong> 18 (2 HD; 2d8+9)</li>  </ul><br /><ul class=\"sbcSemicolonList\"><li><ul class=\"sbcCommaList\" data-content=\"saves\"><li><strong>Fort</strong> +6</li><li><strong>Ref</strong> +3</li><li><strong>Will</strong> +1</li></ul></li>   </ul><br /><ul class=\"sbcSemicolonList\">  <li><strong>Defensive Abilities</strong><ul class=\"sbcCommaList\" data-content=\"defensive-abilities\">  <li>ferocity</li>  </ul></li>       </ul>  </div><div><div class=\"sbcSection\" data-content=\"offense\"><h4>Offense</h4><hr /><strong>Speed</strong><ul class=\"sbcCommaList\" data-content=\"speed\">  <li>Land 40 ft</li>  </ul><br />  <strong>Melee</strong> gore +4 melee (1d8+4)<br />   <ul class=\"sbcSemicolonList\">   </ul>   </div></div>    <div class=\"sbcSection\" data-content=\"statistics\"><h4>Statistics</h4><hr /><ul class=\"sbcCommaList\" data-content=\"attributes\"><li><strong>Str</strong> 17</li><li><strong>Dex</strong> 10</li><li><strong>Con</strong> 17</li><li><strong>Int</strong> 2</li><li><strong>Wis</strong> 13</li><li><strong>Cha</strong> 4</li></ul><br /><ul class=\"sbcSemicolonList\" data-content=\"base-attack\"><li><strong>Base Atk</strong>+1</li><li><strong>CMB</strong> +4</li><li><strong>CMD</strong> 14  </li></ul><br />  <strong>Feats</strong><ul class=\"sbcCommaList\" data-content=\"feats\">  <li>Toughness</li>  </ul><br />   <strong>Skills</strong><ul class=\"sbcCommaList\" data-content=\"skills\">  <li>Perception +6</li>  </ul>  <br />     </div>  <div class=\"sbcSection\" data-content=\"ecology\"><h4>Ecology</h4><hr />  <strong>Environment</strong>   temperate or tropical forests <br />   <strong>Organization</strong>  solitary, pair, or group (3-8)<br />   <strong>Treasure</strong>  none   <br />  </div>      <div class=\"sbcSection\" data-content=\"description\"><h4> Description </h4><hr /><div class=\"sbcPreWrap\">\nMuch more ill-tempered and dangerous than their domesticated kin, boars are omnivorous creatures common to temperate forests, although they are not unknown in tropical climes. Other variants exist as well, such as the particularly ugly warthogs that dwell in tropical plains and savannahs. Boars are often hunted for their flesh, which is considered delicious by most humanoids. Those who hunt boars often do so with a special spear fitted with a cross beam to prevent an impaled boar from pushing forward along the spear shaft to gore its tormentor.\n\nThe boar's stubborn nature and habit of eating even bones makes it well suited as a pet for certain folk. Many thieves' guilds keep boars for the disposal of bodies, while orc tribes let them run loose in their lairs, where they do a relatively good job at keeping these warrens clean of refuse.\n\nA boar is four feet long and weighs 200 pounds.\n</div></div>  </div><hr class=\"sbcBorder\" /></div><p></p></div><br /><hr /><div class=\"rawInputContainer\" style=\"margin-top:15px\"><h2 style=\"text-align:middle;border:none;text-transform:uppercase;color:#000\">RAW INPUT</h2><hr /><pre style=\"white-space:pre-wrap;font-size:14px\">    Boar (CR 2)\nSource PFRPG Bestiary \nCR 2 \nXP 600 \nN Medium animal  \nInit +0; Senses low-light vision, scent; Perception +6   \nDefense   \nAC 14, touch 10, flat-footed 14 (+4 natural)\n\nhp 18 (2d8+9)\n\nFort +6, Ref +3, Will +1 \nDefensive Abilities ferocity   \nOffense   \nSpd 40 ft. \nMelee gore +4 melee (1d8+4)\n\n\n\nStatistics   \nStr 17, Dex 10, Con 17, Int 2, Wis 13, Cha 4 \nBase Atk +1; CMB +4; CMD 14 \nFeats Toughness \nSkills Perception +6   \nEcology   \nEnvironment  temperate or tropical forests \nOrganization solitary, pair, or group (3-8)\n\nTreasure none   \nDescription\n\nMuch more ill-tempered and dangerous than their domesticated kin, boars are omnivorous creatures common to temperate forests, although they are not unknown in tropical climes. Other variants exist as well, such as the particularly ugly warthogs that dwell in tropical plains and savannahs. Boars are often hunted for their flesh, which is considered delicious by most humanoids. Those who hunt boars often do so with a special spear fitted with a cross beam to prevent an impaled boar from pushing forward along the spear shaft to gore its tormentor.\n\nThe boar's stubborn nature and habit of eating even bones makes it well suited as a pet for certain folk. Many thieves' guilds keep boars for the disposal of bodies, while orc tribes let them run loose in their lairs, where they do a relatively good job at keeping these warrens clean of refuse.\n\nA boar is four feet long and weighs 200 pounds.\n    </pre></div>"},"cr":{"base":2},"xp":{"value":0}},"skills":{"acr":{"ability":"dex","rt":false,"acp":true,"rank":0},"apr":{"ability":"int","rt":false,"acp":false,"rank":0},"art":{"ability":"int","rt":false,"acp":false,"rank":0},"blf":{"ability":"cha","rt":false,"acp":false,"rank":0},"clm":{"ability":"str","rt":false,"acp":true,"rank":0},"crf":{"ability":"int","rt":false,"acp":false,"rank":0},"dip":{"ability":"cha","rt":false,"acp":false,"rank":0},"dev":{"ability":"dex","rt":true,"acp":true,"rank":0},"dis":{"ability":"cha","rt":false,"acp":false,"rank":0},"esc":{"ability":"dex","rt":false,"acp":true,"rank":0},"fly":{"ability":"dex","rt":false,"acp":true,"rank":0},"han":{"ability":"cha","rt":true,"acp":false,"rank":0},"hea":{"ability":"wis","rt":false,"acp":false,"rank":0},"int":{"ability":"cha","rt":false,"acp":false,"rank":0},"kar":{"ability":"int","rt":true,"acp":false,"rank":0},"kdu":{"ability":"int","rt":true,"acp":false,"rank":0},"ken":{"ability":"int","rt":true,"acp":false,"rank":0},"kge":{"ability":"int","rt":true,"acp":false,"rank":0},"khi":{"ability":"int","rt":true,"acp":false,"rank":0},"klo":{"ability":"int","rt":true,"acp":false,"rank":0},"kna":{"ability":"int","rt":true,"acp":false,"rank":0},"kno":{"ability":"int","rt":true,"acp":false,"rank":0},"kpl":{"ability":"int","rt":true,"acp":false,"rank":0},"kre":{"ability":"int","rt":true,"acp":false,"rank":0},"lin":{"ability":"int","rt":true,"acp":false,"rank":0},"lor":{"ability":"int","rt":true,"acp":false,"rank":0},"per":{"ability":"wis","rt":false,"acp":false,"rank":2},"prf":{"ability":"cha","rt":false,"acp":false,"rank":0},"pro":{"ability":"wis","rt":true,"acp":false,"rank":0},"rid":{"ability":"dex","rt":false,"acp":true,"rank":0},"sen":{"ability":"wis","rt":false,"acp":false,"rank":0},"slt":{"ability":"d