,"Saving Throw"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[{"_id":"SqMFiUtm","formula":"2","target":"will","type":"untyped","operator":"add","priority":0}],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"115, 129"}]},"type":"feat","effects":[],"folder":null,"sort":512500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.iAbIGhm7T2OK9Brt"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"Tlpk0bEiEmy15Ppk","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125067511,"modifiedTime":1795125070189,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/mobility.jpg","name":"Mobility","system":{"description":{"value":"<p><em>You can easily move through a dangerous melee.</em></p><p><strong>Prerequisites</strong>: Dex 13, @UUID[Compendium.pf1.feats.Item.JreaiTHdyWFNj3Tb]{Dodge}.</p><p><strong>Benefits</strong>: You get a +4 dodge bonus to Armor Class against attacks of opportunity caused when you move out of or within a threatened area. A condition that makes you lose your Dexterity bonus to Armor Class (if any) also makes you lose dodge bonuses.</p><p>Dodge bonuses stack with each other, unlike most types of bonuses.</p>","instructions":""},"tags":["Combat","Movement","Defensive"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"114, 130"}]},"type":"feat","effects":[],"folder":null,"sort":712500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.R7L4SlGRlnThqFrP"}},"ownership":{"default":0}},{"_id":"drB5ENLSV0UuyKbG","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125067584,"modifiedTime":1795125070189,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/spring-attack.jpg","name":"Spring Attack","system":{"description":{"value":"<p><em>You can deftly move up to a foe, strike, and withdraw before he can react.</em></p><p><strong>Prerequisites</strong>: Dex 13, @UUID[Compendium.pf1.feats.Item.JreaiTHdyWFNj3Tb]{Dodge}, @UUID[Compendium.pf1.feats.Item.R7L4SlGRlnThqFrP]{Mobility}, base attack bonus +4.</p><p><strong>Benefits</strong>: As a full-round action, you can move up to your speed and make a single melee attack without provoking any attacks of opportunity from the target of your attack. You can move both before and after the attack, but you must move at least 10 feet before the attack and the total distance that you move cannot be greater than your speed. You cannot use this ability to attack a foe that is adjacent to you at the start of your turn.</p><p><strong>Normal</strong>: You cannot move before and after an attack.</p>","instructions":""},"tags":["Combat","Offensive","Movement"],"actions":[{"_id":"9ilekjpdPWfwe7eo","activation":{"type":"full","unchained":{"cost":3,"type":"action"},"cost":1},"duration":{"units":"inst"},"name":"Use","range":{"units":"seeText"},"target":{"value":"One Target"},"actionType":"other","uses":{},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"114, 134"}]},"type":"feat","effects":[],"folder":null,"sort":812500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.ugQyUpqPBDsqLyra"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"IA2IUxfItDDg4xAb","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125067644,"modifiedTime":1795125070189,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/weapon-finesse.jpg","name":"Weapon Finesse","system":{"description":{"value":"<i>You are trained in using your agility in melee combat, as opposed to brute strength.</i><p><strong>Benefits</strong>: With a light weapon, rapier, whip, or spiked chain made for a creature of your size category, you may use your Dexterity modifier instead of your Strength modifier on attack rolls. If you carry a shield, its armor check penalty applies to your attack rolls.</p><p><strong>Special</strong>: Natural weapons are considered light weapons.</p>","instructions":""},"tags":["Combat","Weapon"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{"bonus_finesse":true,"target_finesse":true},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"117, 136"}]},"type":"feat","effects":[],"folder":null,"sort":912500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.vWiTqHC4Y3Xn1Pme"}},"ownership":{"default":0}},{"_id":"L8rM7371uDmJZh9f","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125068236,"modifiedTime":1795125070189,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/extra-lay-on-hands.jpg","name":"Burn (1d8, DC 16)","system":{"description":{"value":"<p>The creature deals fire damage in addition to damage dealt on a successful hit in melee. A creature affected by the burn ability must also succeed at a Reflex save or catch fire, taking the listed damage for an additional 1d4 rounds at the start of its turn (DC = 10 + 1/2 burning creature’s racial HD + burning creature’s Constitution modifier). A creature suffering from this effect can attempt a new save as a full-round action. Dropping and rolling on the ground grants a +4 bonus on this save. Creatures that hit a burning creature with natural weapons or unarmed attacks take fire damage as though hit by the burning creature and must succeed at a Reflex save to avoid <a href=\"https://www.aonprd.com/Rules.aspx?Name=Catching%20on%20Fire&amp;Category=Heat%20Dangers\">catching on fire</a>.</p><p><em>Format</em>: burn (2d6, DC 15)</p><p><em>Location</em>: Special Attacks and individual attacks.</p><p><em>Usage:</em> Replace duration, damage, and DC.</p>","instructions":""},"tags":["Universal Monster Rules"],"actions":[{"_id":"2tsnjvwyniyu2t3g","actionType":"save","activation":{"type":"passive","unchained":{"type":"passive","cost":1},"cost":1},"damage":{"parts":[{"formula":"1d8"}]},"duration":{"units":"round","value":"1d4"},"img":"systems/pf1/icons/feats/extra-lay-on-hands.jpg","name":"Use","notes":{"effect":["DC = 10 + 1/2 burning creature’s racial HD + burning creature’s Constitution modifier",""]},"save":{"dc":"15 + 1","type":"ref","harmless":false},"tag":"burnEx","uses":{},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null