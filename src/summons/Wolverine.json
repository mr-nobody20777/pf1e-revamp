tFormula":"","preparedOffsetFormula":""},"spell9":{"castPerDayOffsetFormula":"","preparedOffsetFormula":""}},"spellSlotAbilityBonusFormula":"","domainSlotValue":1}}},"cmb":{}},"details":{"height":"","weight":"","gender":"","deity":"","age":"","alignment":"tn","biography":{"value":""},"bonusFeatFormula":"","bonusSkillRankFormula":"","carryCapacity":{"bonus":{"user":0},"multiplier":{"base":1,"user":0}},"notes":{"value":"<div style=\"margin-top:15px;margin-bottom:5px;text-align:center;font-size:1em;font-weight:900\"><p>sbc | Generated with version 6.0.3 on November 19, 2026</p></div><hr /><div class=\"statblockContainer\" style=\"margin-top:15px\"><p></p><div class=\"sbcStatBlock\"><hr class=\"sbcBorder\" /><div style=\"padding:5px\"><h1>Wolverine <ul class=\"sbcSlashList\">   </ul></h1>  <hr /><div class=\"sbcSection\" data-content=\"base\"> <strong>Source</strong> PFRPG Bestiary<br /> <strong>XP</strong> 600<br />     <br /> N  Medium  Animal  <ul class=\"sbcCommaList sbcParensWrappedList\">    </ul><br /><ul class=\"sbcSemicolonList\"><li><strong>Init</strong>  +2</li>  <li><strong>Senses</strong><ul class=\"sbcCommaList\" data-content=\"senses\">  <li>Low-light</li>  <li>Scent 0 ft</li>  </ul></li>   <span><strong>Perception</strong> +10</span>  </ul><br />  </div><div class=\"sbcSection\" data-content=\"defense\"><h4>Defense</h4><hr /><ul class=\"sbcCommaList\"><li><strong>AC</strong> 14</li><li><strong>Touch</strong> 12</li><li><strong>Flat-footed</strong> 12</li></ul>  <ul class=\"sbcParensWrappedList sbcCommaList\" data-group=\"armor\">  <li>+2 Dex</li>  <li>+2 Natural</li>  </ul>  <br /><ul class=\"sbcSemicolonList\"><li><strong>Hit Points</strong> 22 (3 HD; 3d8+9)</li>  </ul><br /><ul class=\"sbcSemicolonList\"><li><ul class=\"sbcCommaList\" data-content=\"saves\"><li><strong>Fort</strong> +5</li><li><strong>Ref</strong> +5</li><li><strong>Will</strong> +2</li></ul></li>   </ul><br /><ul class=\"sbcSemicolonList\">       </ul>  </div><div><div class=\"sbcSection\" data-content=\"offense\"><h4>Offense</h4><hr /><strong>Speed</strong><ul class=\"sbcCommaList\" data-content=\"speed\">  <li>Land 30 ft</li>  <li>Climb 10 ft</li>  <li>Burrow 10 ft</li>  </ul><br />  <strong>Melee</strong> 2 claws +4 (1d6+2), bite +4 (1d4+2)<br />   <ul class=\"sbcSemicolonList\">   </ul>   <strong>Special Attacks</strong><ul class=\"sbcCommaList\" data-content=\"special-attacks\">  <li>rage</li>  </ul><br />  </div></div>    <div class=\"sbcSection\" data-content=\"statistics\"><h4>Statistics</h4><hr /><ul class=\"sbcCommaList\" data-content=\"attributes\"><li><strong>Str</strong> 15</li><li><strong>Dex</strong> 15</li><li><strong>Con</strong> 15</li><li><strong>Int</strong> 2</li><li><strong>Wis</strong> 12</li><li><strong>Cha</strong> 10</li></ul><br /><ul class=\"sbcSemicolonList\" data-content=\"base-attack\"><li><strong>Base Atk</strong>+2</li><li><strong>CMB</strong> +4</li><li><strong>CMD</strong> 16  (20 vs. trip) </li></ul><br />  <strong>Feats</strong><ul class=\"sbcCommaList\" data-content=\"feats\">  <li>Skill Focus <ul class=\"sbcCommaList sbcParensWrappedList\">  <li>Perception</li>  </ul></li>  <li>Toughness</li>  </ul><br />   <strong>Skills</strong><ul class=\"sbcCommaList\" data-content=\"skills\">  <li>Climb +10</li>  <li>Perception +10</li>  </ul>  <br />     </div>  <div class=\"sbcSection\" data-content=\"ecology\"><h4>Ecology</h4><hr />  <strong>Environment</strong>   cold forests <br />   <strong>Organization</strong>  solitary <br />   <strong>Treasure</strong>  none   <br />  </div>    <div class=\"sbcSection\" data-content=\"special-abilities\"><h4> Special Abilities </h4><hr />  <p><strong>Rage (Ex)</strong> A wolverine that takes damage in combat flies into a rage on its next turn, clawing and biting madly until either it or its opponent is dead. It gains +4 to Strength, +4 to Constitution, and -2 to AC. The creature cannot end its rage voluntarily.    </p>  </div>    <div class=\"sbcSection\" data-content=\"description\"><h4> Description </h4><hr /><div class=\"sbcPreWrap\">\nWolverines are territorial, especially when it comes to food, and have been known to defend their kills against much larger predators, such as black bears. They are fearsome opponents, launching into a frenzy when wounded. They tend to give off a very strong, unpleasant musk smell when angry.\n\nArmed with powerful jaws, strong legs, and a thick hide, wolverines are remarkably strong for their size.\n\nThey are reckless in battle and throw themselves at their foes, clawing and biting furiously.\n</div></div>  </div><hr class=\"sbcBorder\" /></div><p></p></div><br /><hr /><div class=\"rawInputContainer\" style=\"margin-top:15px\"><h2 style=\"text-align:middle;border:none;text-transform:uppercase;color:#000\">RAW INPUT</h2><hr /><pre style=\"white-space:pre-wrap;font-size:14px\">    Wolverine (CR 2)\nSource PFRPG Bestiary \nCR 2 \nXP 600 \nN Medium animal  \nInit +2; Senses low-light vision, scent; Perception +10   \nDefense   \nAC 14, touch 12, flat-footed 12 (+2 Dex, +2 natural)\n\nhp 22 (3d8+9)\n\nFort +5, Ref +5, Will +2   \nOffense   \nSpd 30 ft., burrow 10 ft., climb 10 ft. \nMelee 2 claws +4 (1d6+2), bite +4 (1d4+2)\n\nSpecial Attacks rage   \nStatistics   \nStr 15, Dex 15, Con 15, Int 2, Wis 12, Cha 10 \nBase Atk +2; CMB +4; CMD 16 (20 vs. trip)\n\nFeats Skill Focus (Perception), Toughness \nSkills Climb +10, Perception +10   \nEcology   \nEnvironment  cold forests \nOrganization solitary \nTreasure none   \nSpecial abilities   \nRage (Ex) A wolverine that takes damage in combat flies into a rage on its next turn, clawing and biting madly until either it or its opponent is dead. It gains +4 to Strength, +4 to Constitution, and -2 to AC. The creature cannot end its rage voluntarily.   \nDescription\n\nWolverines are territorial, especially when it comes to food, and have been known to defend their kills against much larger predators, such as black bears. They are fearsome opponents, launching into a frenzy when wounded. They tend to give off a very strong, unpleasant musk smell when angry.\n\nArmed with powerful jaws, strong legs, and a thick hide, wolverines are remarkably strong for their size.\n\nThey are reckless in battle and throw themselves at their foes, clawing and biting furiously.\n    </pre></div>"},"cr":{"base":2},"xp":{"value":0}},"skills":{"acr":{"ability":"dex","rt":false,"acp":true,"rank":0},"apr":{"ability":"int","rt":false,"acp":false,"rank":0},"art":{"ability":"int","rt":false,"acp":false,"rank":0},"blf":{"ability":"cha","rt":false,"acp":false,"rank":0},"clm":{"ability":"str","rt":false,"acp":true,"rank":0},"crf":{"ability":"int","rt":false,"acp":false,"rank":0},"dip":{"ability":"cha","rt":false,"acp":false,"rank":0},"dev":{"ability":"dex","rt":true,"acp":true,"rank":0},"dis":{"ability":"cha","rt":false,"acp":false,"rank":0},"esc":{"ability":"dex","rt":false,"acp":true,"rank":0},"fly":{"ability":"dex","rt":false,"acp":true,"rank":0},"han":{"ability":"cha","rt":true,"acp":false,"rank":0},"hea":{"ability":"wis","rt":false,"acp":false,"rank":0},"int":{"ability":"cha","rt":false,"acp":false,"rank":0},"kar":{"ability":"int","rt":true,"acp":false,"rank":0},"kdu":{"ability":"int","rt":true,"acp":false,"rank":0},"ken":{"ability":"int","rt":true,"acp":false,"rank":0},"kge":{"ability":"int","rt":true,"acp":false,"rank":0},"khi":{"ability":"int","rt":true,"acp":false,"rank":0},"klo":{"ability":"int","rt":true,"acp":false,"rank":0},"kna":{"ability":"int","rt":true,"acp":false,"rank":0},"kno":{"ability":"int","rt":true,"acp":false,"rank":0},"kpl":{"ability":"int","rt":true,"acp":false,"rank":0},"kre":{"ability":"int","rt":true,"acp":false,"rank":0},"lin":{"ability":"int","rt":true,"acp":false,"rank":0},"lor":{"ability":"int","rt":true,"acp":false,"rank":0},"per":{"ability":"wis","rt":false,"acp":false,"rank":3},"prf":{"ability":"cha","rt":false,"acp":false,"rank":0},"pro":{"ability":"wis","rt":true,"acp":false,"rank":0},"rid":{"ability":"dex","rt":fal