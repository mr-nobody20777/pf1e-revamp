cludes notes on how often it can be used.</p><p><em>Format:</em> breath weapon (60-ft. cone, 8d6 fire damage, Reflex DC 20 for half, usable every 1d4 rounds</p><p><em>Location:</em> Special Attacks; if the breath does more than just deal damage, it also appears under Special Abilities with its own entry.</p>","instructions":"<p>Change the damage and area in the action. Also change the saving type if needed.</p><p>Change the recharge formula if needed (currently set to every 1d4 rounds).</p>"},"tags":[],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":5,"per":"round","autoDeductChargesCost":"1d4 + 1","maxFormula":"5","rechargeFormula":"@item.uses.value + 1"},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"su","associations":{"classes":[]},"showInQuickbar":true,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"showInCombat":true,"sources":[{"id":"PZO1112","pages":"298"},{"id":"PZO1116","pages":"294"},{"id":"PZO1120","pages":"292"},{"id":"PZO1127","pages":"290"},{"id":"PZO1133","pages":"290"},{"id":"PZO1137","pages":"291"}]},"type":"feat","effects":[],"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.monster-abilities.Item.bg2m81Euc7kGdiKN"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"bTku7xoun9EaNFH0","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124962316,"modifiedTime":1795124964529,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"folder":"xPJd6syoxDiunnzG","img":