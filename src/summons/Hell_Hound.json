l)</div><div><strong>Organization</strong>:  solitary, pair, or pack (3-12)</div><div><strong>Treasure</strong>:  incidental   </div>","instructions":""},"tags":[],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{}},"img":"icons/environment/wilderness/tree-oak.webp","_id":"k2VYq1uEL7HPYaEo","effects":[],"folder":null,"sort":212500,"flags":{},"_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124962585,"modifiedTime":1795124964529,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"name":"Miscellaneous Notes","type":"feat","system":{"description":{"value":"<p>This feature was created by <strong>SBC</strong> to collect any notes that don't have a source on the actor,\n                such as saving throw details or a bonus to CMD from extra legs. It may also be used to record a natural armor bonus,\n                spell resistance bonus, or spellcasting notes.</p><p><strong>CMD Notes:</strong></p><p>+4 vs. trip</p>","instructions":""},"tags":[],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[{"formula":"5","type":"untyped","target":"nac","_id"