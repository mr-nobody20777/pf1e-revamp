ffsetFormula":"","preparedOffsetFormula":""},"spell9":{"castPerDayOffsetFormula":"","preparedOffsetFormula":""}},"spellSlotAbilityBonusFormula":"","domainSlotValue":1}}},"cmb":{}},"details":{"height":"","weight":"","gender":"","deity":"","age":"","alignment":"le","biography":{"value":""},"bonusFeatFormula":"","bonusSkillRankFormula":"","carryCapacity":{"bonus":{"user":0},"multiplier":{"base":1,"user":0}},"notes":{"value":"<div style=\"margin-top:15px;margin-bottom:5px;text-align:center;font-size:1em;font-weight:900\"><p>sbc | Generated with version 6.0.3 on November 19, 2026</p></div><hr /><div class=\"statblockContainer\" style=\"margin-top:15px\"><p></p><div class=\"sbcStatBlock\"><hr class=\"sbcBorder\" /><div style=\"padding:5px\"><h1>Hell Hound <ul class=\"sbcSlashList\">   </ul></h1>  <hr /><div class=\"sbcSection\" data-content=\"base\"> <strong>Source</strong> PFRPG Bestiary<br /> <strong>XP</strong> 800<br />     <br /> LE  Medium  Outsider  <ul class=\"sbcCommaList sbcParensWrappedList\">  <li>Evil</li>  <li>Extraplanar</li>  <li>Fire</li>  <li>Lawful</li>  </ul><br /><ul class=\"sbcSemicolonList\"><li><strong>Init</strong>  +5</li>  <li><strong>Senses</strong><ul class=\"sbcCommaList\" data-content=\"senses\">  <li>Darkvision 60 ft</li>  <li>Scent 0 ft</li>  </ul></li>   <span><strong>Perception</strong> +7</span>  </ul><br />  </div><div class=\"sbcSection\" data-content=\"defense\"><h4>Defense</h4><hr /><ul class=\"sbcCommaList\"><li><strong>AC</strong> 16</li><li><strong>Touch</strong> 11</li><li><strong>Flat-footed</strong> 15</li></ul>  <ul class=\"sbcParensWrappedList sbcCommaList\" data-group=\"armor\">  <li>+1 Dex</li>  <li>+5 Natural</li>  </ul>  <br /><ul class=\"sbcSemicolonList\"><li><strong>Hit Points</strong> 30 (4 HD; 4d10+8)</li>  </ul><br /><ul class=\"sbcSemicolonList\"><li><ul class=\"sbcCommaList\" data-content=\"saves\"><li><strong>Fort</strong> +6</li><li><strong>Ref</strong> +5</li><li><strong>Will</strong> +1</li></ul></li>   </ul><br /><ul class=\"sbcSemicolonList\">    <li><strong>Immune</strong><ul class=\"sbcCommaList\" data-content=\"immune\">  <li>Fire</li>  </ul></li>     </ul>  <br /><strong>Weaknesses</strong> vulnerability to cold  </div><div><div class=\"sbcSection\" data-content=\"offense\"><h4>Offense</h4><hr /><strong>Speed</strong><ul class=\"sbcCommaList\" data-content=\"speed\">  <li>Land 40 ft</li>  </ul><br />  <strong>Melee</strong> bite +5 (1d8+1 plus 1d6 fire)<br />   <ul class=\"sbcSemicolonList\">   </ul>   <strong>Special Attacks</strong><ul class=\"sbcCommaList\" data-content=\"special-attacks\">  <li>Breath Weapon (10-ft. Cone, Once Every 2D4  Rounds, 2D6 Fire Damage, Reflex DC 14 For Half)</li>  </ul><br />  </div></div>    <div class=\"sbcSection\" data-content=\"statistics\"><h4>Statistics</h4><hr /><ul class=\"sbcCommaList\" data-content=\"attributes\"><li><strong>Str</strong> 13</li><li><strong>Dex</strong> 13</li><li><strong>Con</strong> 15</li><li><strong>Int</strong> 6</li><li><strong>Wis</strong> 10</li><li><strong>Cha</strong> 6</li></ul><br /><ul class=\"sbcSemicolonList\" data-content=\"base-attack\"><li><strong>Base Atk</strong>+4</li><li><strong>CMB</strong> +5</li><li><strong>CMD</strong> 16  (20 vs. trip) </li></ul><br />  <strong>Feats</strong><ul class=\"sbcCommaList\" data-content=\"feats\">  <li>Improved Initiative</li>  <li>Run</li>  </ul><br />   <strong>Skills</strong><ul class=\"sbcCommaList\" data-content=\"skills\">  <li>Acrobatics +8</li>  <li>Perception +7</li>  <li>Stealth +13</li>  <li>Survival +7</li>  </ul>  <br />   <strong>Languages</strong><ul class=\"sbcCommaList\" data-content=\"languages\">  <li>Infernal (cannot speak)</li>  </ul><br />    </div>  <div class=\"sbcSection\" data-content=\"ecology\"><h4>Ecology</h4><hr />  <strong>Environment</strong>   any (Hell)<br />   <strong>Organization</strong>  solitary, pair, or pack (3-12)<br />   <strong>Treasure</strong>  incidental   <br />  </div>      <div class=\"sbcSection\" data-content=\"description\"><h4> Description </h4><hr /><div class=\"sbcPreWrap\">\nA typical hell hound stands 4-5 feet tall at the shoulder and weighs 120 pounds. Efficient hunters, a favorite pack tactic is to surround prey quietly, then attack with one or two hounds, driving prey toward the rest of the pack with their fiery breath.\n\nIf the prey doesn't run, the pack closes in. Hell hounds track fleeing creatures relentlessly.\n\nHell hounds are particularly favored by fire giants, as the creatures are immune to fire and share the fire giant's sense of cruelty when it comes to handling intruders. Only when a fire giant goes too far toward treating a relatively intelligent hell hound like a pet do such alliances begin to falter.\n</div></div>  </div><hr class=\"sbcBorder\" /></div><p></p></div><br /><hr /><div class=\"rawInputContainer\" style=\"margin-top:15px\"><h2 style=\"text-align:middle;border:none;text-transform:uppercase;color:#000\">RAW INPUT</h2><hr /><pre style=\"white-space:pre-wrap;font-size:14px\">    Hell Hound (CR 3)\nSource PFRPG Bestiary \nCR 3 \nXP 800 \nLE Medium outsider (evil, extraplanar, fire, lawful)\n\nInit +5; Senses darkvision 60 ft., scent; Perception +7   \nDefense   \nAC 16, touch 11, flat-footed 15 (+1 Dex, +5 natural)\n\nhp 30 (4d10+8)\n\nFort +6, Ref +5, Will +1 \nImmune fire \nWeaknesses vulnerability to cold   \nOffense   \nSpd 40 ft. \nMelee bite +5 (1d8+1 plus 1d6 fire)\n\nSpecial Attacks breath weapon (10-ft. cone, once every 2d4  rounds, 2d6 fire damage, Reflex DC 14 for half )\n\n\n\nStatistics   \nStr 13, Dex 13, Con 15, Int 6, Wis 10, Cha 6 \nBase Atk +4; CMB +5; CMD 16 (20 vs. trip)\n\nFeats Improved Initiative, Run \nSkills Acrobatics +8, Perception +7, Stealth +13, Survival +7; Racial Modifiers +5 Stealth \nLanguages Infernal (cannot speak)\n\n\n\nEcology   \nEnvironment  any (Hell)\n\nOrganization solitary, pair, or pack (3-12)\n\nTreasure incidental   \nDescription\n\nA typical hell hound stands 4-5 feet tall at the shoulder and weighs 120 pounds. Efficient hunters, a favorite pack tactic is to surround prey quietly, then attack with one or two hounds, driving prey toward the rest of the pack with their fiery breath.\n\nIf the prey doesn't run, the pack closes in. Hell hounds track fleeing creatures relentlessly.\n\nHell hounds are particularly favored by fire giants, as the creatures are immune to fire and share the fire giant's sense of cruelty when it comes to handling intruders. Only when a fire giant goes too far toward treating a relatively intelligent hell hound like a pet do such alliances begin to falter.\n    </pre></div>"},"cr":{"base":3},"xp":{"value":0}},"skills":{"acr":{"ability":"dex","rt":false,"acp":true,"rank":4},"apr":{"ability":"int","rt":false,"acp":false,"rank":0},"art":{"ability":"int","rt":false,"acp":false,"rank":0},"blf":{"ability":"cha","rt":false,"acp":false,"rank":0},"clm":{"ability":"str","rt":false,"acp":true,"rank":0},"crf":{"ability":"int","rt":false,"acp":false,"rank":0},"dip":{"ability":"cha","rt":false,"acp":false,"rank":0},"dev":{"ability":"dex","rt":true,"acp":true,"rank":0},"dis":{"ability":"cha","rt":false,"acp":false,"rank":0},"esc":{"ability":"dex","rt":false,"acp":true,"rank":0},"fly":{"ability":"dex","rt":false,"acp":true,"rank":0},"han":{"ability":"cha","rt":true,"acp":false,"rank":0},"hea":{"ability":"wis","rt":false,"acp":false,"rank":0},"int":{"ability":"cha","rt":false,"acp":false,"rank":0},"kar":{"ability":"int","rt":true,"acp":false,"rank":0},"kdu":{"ability":"int","rt":true,"acp":false,"rank":0},"ken":{"ability":"int","rt":true,"acp":false,"rank":0},"kge":{"ability":"int","rt":true,"acp":false,"rank":0},"khi":{"ability":"int","rt":true,"acp":false,"rank":0},"klo":{"ability":"int","rt":true,"acp":false,"rank":0},"kna":{"ability":"int","rt":true,"acp":false,"rank":0},"kno":{"ability":"int","rt":true,"acp":false,"rank":0},"kpl":{"ability":"int","rt":true,"acp":false,"rank":0},"kre":{"ability":"int","rt":true,"acp":false,"rank":0},"