13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125013843,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"name":"Boiling Rain","type":"feat","system":{"description":{"value":"<p>Once per day a steam mephit can create a rainstorm of boiling water in a 20-foot-square area. Living creatures within the area take 2d6 points of fire damage (Fortitude DC 14 half; caster level 6th). This ability is the equivalent of a 2nd-level spell.   </p>","instructions":""},"tags":[],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"su","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{}},"img":"systems/pf1/icons/skills/yellow_36.jpg","_id":"lRRuuseD2Ty0gMew","effects":[],"folder":null,"sort":112500,"flags":{},"_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125013873,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"name":"Outsider","type":"race","system":{"description":{"value":"<p>An outsider is at least partially composed of the essence (but not necessarily the material) of some plane other than the Material Plane. Some creatures start out as some other type and become outsiders when they attain a higher (or lower) state of spiritual existence.</p>\n<h2>Features</h2>\n<p>An outsider has the following features.</p>\n<ul>\n<li>d10 Hit Dice.</li>\n<li>Base attack bonus equal to total Hit Dice (fast progression).</li>\n<li>Two good saving throws, usually <em>Reflex</em> and Will.</li>\n<li>Skill points equal to 6 + Int modifier (minimum 1) per Hit Die. The following are class skills for outsiders: <em>Bluff</em>, <em>Craft</em>, <em>Knowledge</em> (planes), <em>Perception</em>, <em>Sense Motive</em>, and <em>Stealth</em>. Due to their varied nature, outsiders also receive 4 additional class skills determined by the creature’s theme.</li>\n</ul>\n<h2>Traits</h2>\n<p>An outsider possesses the following traits (unless otherwise noted in a creature’s entry).</p>\n<ul>\n<li>Darkvision 60 feet.</li>\n<li>Unlike most living creatures, an outsider does not have a dual nature—its soul and body form one unit. When an outsider is slain, no soul is set loose. Spells that restore souls to their bodies, such as <em>raise dead</em>, <em>reincarnate</em>, and <em>resurrection</em>, don’t work on an outsider. It takes a different magical effect, such as <em>limited wish</em>, <em>wish</em>, <em>miracle</em>, or <em>true resurrection</em> to restore it to life. An outsider with the native subtype can be raised, reincarnated, or resurrected just as other living creatures can be.</li>\n<li>Proficient with all simple and martial weapons and any weapons mentioned in its entry.</li>\n<li>Proficient with whatever type of armor (light, medium, or heavy) it is described as wearing, as well as all lighter types. Outsiders not indicated as wearing armor are not proficient with armor. Outsiders are proficient with shields if they are proficient with any form of armor.</li>\n<li>Outsiders breathe, but do not need to eat or sleep (although they can do so if they wish). Native outsiders breathe, eat, and sleep.</li>\n</ul>","instructions":""},"tags":[],"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"supplements":[]},"armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"size":"sm","speeds":{"land":null,"fly":null,"flyManeuverability":"","swim":null,"climb":null,"burrow":null},"creatureTypes":["outsider"],"creatureSubtypes":["fire"],"sources":[{"id":"PZO1112","pages":"309"}]},"img":"systems/pf1/icons/skills/yellow_40.jpg","_id":"wnjWMaDtS2m9Proi","effects":[],"folder":null,"sort":112500,"flags":{},"_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125014058,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"_id":"VbN6MZSpbbdwbWmJ","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125014123,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/skills/yellow_40.jpg","name":"Outsider","system":{"description":{"value":"<p>An outsider is at least partially composed of the essence (but not necessarily the material) of some plane other than the Material Plane. Some creatures start out as some other type and become outsiders when they attain a higher (or lower) state of spiritual existence.</p>\n<h2>Features</h2>\n<p>An outsider has the following features.</p>\n<ul>\n<li>d10 Hit Dice.</li>\n<li>Base attack bonus equal to total Hit Dice (fast progression).</li>\n<li>Two good saving throws, usually <em>Reflex</em> and Will.</li>\n<li>Skill points equal to 6 + Int modifier (minimum 1) per Hit Die. The following are class skills for outsiders: <em>Bluff</em>, <em>Craft</em>, <em>Knowledge</em> (planes), <em>Perception</em>, <em>Sense Motive</em>, and <em>Stealth</em>. Due to their varied nature, outsiders also receive 4 additional class skills determined by the creature’s theme.</li>\n</ul>\n<h2>Traits</h2>\n<p>An outsider possesses the following traits (unless otherwise noted in a creature’s entry).</p>\n<ul>\n<li>Darkvision 60 feet.</li>\n<li>Unlike most living creatures, an outsider does not have a dual nature—its soul and body form one unit. When an outsider is slain, no soul is set loose. Spells that restore souls to their bodies, such as <em>raise dead</em>, <em>reincarnate</em>, and <em>resurrection</em>, don’t work on an outsider. It takes a different magical effect, such as <em>limited wish</em>, <em>wish</em>, <em>miracle</em>, or <em>true resurrection</em> to restore it to life. An outsider with the native subtype can be raised, reincarnated, or resurrected just as other living creatures can be.</li>\n<li>Proficient with all simple and martial weapons and any weapons mentioned in its entry.</li>\n<li>Proficient with whatever type of armor (light, medium, or heavy) it is described as wearing, as well as all lighter types. Outsiders not indicated as wearing armor are not proficient with armor. Outsiders are proficient with shields if they are proficient with any form of armor.</li>\n<li>Outsiders breathe, but do not need to eat or sleep (although they can do so if they wish). Native outsiders breathe, eat, and sleep.</li>\n</ul>","instructions":""},"tags":[],"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"classAssociations":[],"supplements":[]},"tag":"outsider","armorProf":[],"weaponProf":["simple","martial"],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"racial","level":3,"hd":10,"hp":16,"bab":"high","skillsPerLevel":6,"savingThrows":{"fort":{"value":"low"},"ref":{"value":"high"},"will":{"value":"high"}},"fc":{"hp":{"value":0},"skill":{"value":0},"alt":{"value":0,"notes":""}},"wealth":"","alignment":"","classSkills":{"blf":true,"crf":true,"kpl":true,"per":true,"sen":true,"ste":true,"fly":true},"sources":[{"id":"PZO1112","pages":"309"}]},"type":"class","effects":[],"folder":null,"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.racial-hd.Item.cV7yHt8i5YCV0ZTd"}},"ownership":{"default":0}},{"_id":"diZTyYl8wHSNI5g6","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125014462,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/dodge.jpg","name":"Dodge","system":{"description":{"value":"<i>Your training and reflexes allow you to react swiftly to avoid an opponents' attacks.</i><p><strong>Prerequisites</strong>: Dex 13.</p><p><strong>Benefits</strong>: You gain a +1 dodge bonus to your AC. A condition that makes you lose your Dex bonus to AC also makes you lose the benefits of this feat.</p>","instructions":""},"tags":["Combat","Defensive"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[{"_id":"ka6iaUg9","formula":"1","target":"ac","type":"dodge","operator":"add","priority":0}],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"114, 122"}]},"type":"feat","effects":[],"folder":null,"sort":412500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.JreaiTHdyWFNj3Tb"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"hBz6TEvU7KZjLDkh","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125014506,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/improved-initiative.jpg","name":"Improved Initiative","system":{"description":{"value":"<p><em>Your quick reflexes allow you to react rapidly to danger.</em></p><p><strong>Benefits</strong>: You get a +4 bonus on initiative checks.</p>","instructions":""},"tags":["Combat"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[{"_id":"R2qxNHhN","formula":"4","target":"init","type":"untyped","operator":"add","priority":0}],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"115, 127"}]},"type":"feat","effects":[],"folder":null,"sort":612500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.Uuiu3p982omhMEPj"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"PibyqXZGGwVBaQxs","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125015096,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/skills/blue_26.jpg","name":"Summon (level 2,  mephit of the same type 25%)","system":{"description":{"value":"<p>A creature with the summon ability can summon other specific creatures of its kind much as though casting a <a>summon monster</a> spell, but it usually has only a limited chance of success (as specified in the creature’s entry). Roll d%; on a failure, no creature answers the summons. Summoned creatures automatically return to wherever they came from after 1 hour. A creature summoned in this way cannot use any spells or spell-like abilities that require material components costing more than 1 gp unless those components are supplied, nor can it use its own summon ability for 1 hour. An appropriate spell level is given for each summoning ability for the purposes of caster level checks, concentration checks, and Will saves. No experience points are awarded for defeating summoned monsters.</p><p><em>Format</em>: 1/day—summon (level 4, 1 <a href=\"https://www.aonprd.com/MonsterDisplay.aspx?ItemName=Hezrou\">hezrou</a> 35%)</p><p><em>Location</em>: Spell-Like Abilities.</p>","instructions":""},"tags":["Universal Monster Rules"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":1,"per":"day","autoDeductChargesCost":"","maxFormula":"1","rechargeFormula":"","max":1},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"sp","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{}},"type":"feat","effects":[],"folder":null,"sort":812500,"flags":{"core":{"sourceId":"Compendium.pf-content.pf-universal-monster-rules.Item.iDvNySIdxxIWPM6g"}},"ownership":{"default":0}},{"_id":"Y7YVNkAWKtlTnzv7","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125015474,"modifiedTime":1795125017296,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"folder":"gb3ao0esijDaJx1q","img":"icons/magic/defensive/illusion-evasion-echo-purple.webp","name":"Blur","system":{"description":{"value":"<p>The subject's outline appears blurred, shifting, and wavering. This distortion grants the subject concealment (20% miss chance).</p><p>A <i>see invisibility</i> spell does not counteract the <i>blur</i> effect, but a <i>true seeing</i> spell does.</p><p>Opponents that cannot see the subject ignore the spell's effect (though fighting an unseen opponent carries penalties of its own).</p>","instructions":""},"tags":[],"actions":[{"_id":"p9icu763kpe52lkt","actionType":"spellsave","activation":{"type":"standard","unchained":{"cost":2,"type":"action"},"cost":1},"duration":{"units":"minute","value":"@cl"},"name":"Use","range":{"units":"touch"},"save":{"description":"Will negates","harmless":true,"type":"will"},"target":{"value":"creature touched"},"uses":{},"ability":{"critRange":20,"critMult":2},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"links":{"children":[],"supplements":[]},"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"learnedAt":{"class":{"alchemist":2,"arcanist":2,"bard":2,"investigator":2,"magus":2,"medium":2,"mesmerist":2,"occultist":2,"psychic":2,"skald":2,"sorcerer":2,"spiritualist":2,"summoner":2,"summonerUnchained":2,"wizard":2},"domain":{},"subDomain":{},"elementalSchool":{},"bloodline":{"Destined":2,"Protean":2}},"level":1,"clOffset":0,"slOffset":0,"school":"ill","subschool":["glamer"],"descriptors":[],"components":{"value":"","verbal":true,"somatic":false,"thought":false,"emotion":false,"material":false,"focus":false,"divineFocus":0},"materials":{"value":"","focus":"","gpValue":0},"spellbook":"primary","preparation":{"value":0,"max":0},"uses":{"autoDeductChargesCost":""},"atWill":false,"sr":true,"showInQuickbar":false,"domain":false,"slotCost":1,"sources":[{"id":"PZO1110","pages":"251"}],"spellPoints":{"cost":"1 + @sl"}},"type":"spell","effects":[],"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.spells.Item.18kryvj2dfuymk9d"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"oxjS7tdSNjewM1KU","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125015682,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"folder":"ks1gs7KC2CO3U9hN","img":"icons/creatures/abilities/dragon-fire-breath-orange.webp","name":"Breath Weapon (15-foot Cone, Effect Based On Type, Reflex DC 13 For Half)","system":{"description":{"value":"<p>Some creatures can exhale a cloud, cone, or line of magical effects. A breath weapon usually deals damage and is often based on some type of energy. Breath weapons allow a Reflex save for half damage (DC = 10 + 1/2 breathing creature's racial HD + breathing creature's Constitution modifier; the exact DC is given in the creature's descriptive text). A creature is immune to its own breath weapon unless otherwise noted. Some breath weapons allow a Fortitude save or a Will save instead of a Reflex save. Each breath weapon also includes notes on how often it can be used.</p><p><em>Format:</em> breath weapon (60-ft. cone, 8d6 fire damage, Reflex DC 20 for half, usable every 1d4 rounds</p><p><em>Location:</em> Special Attacks; if the breath does more than just deal damage, it also appears under Special Abilities with its own entry.</p>","instructions":"<p>Change the damage and area in the action. Also change the saving type if needed.</p><p>Change the recharge formula if needed (currently set to every 1d4 rounds).</p>"},"tags":[],"actions":[{"_id":"nl3a5LBTO47ruwWd","actionType":"save","activation":{"type":"standard","unchained":{"cost":2,"type":"action"},"cost":1},"area":"60-ft. cone","damage":{"parts":[{"formula":"8d6","types":["fire"]}]},"duration":{"units":"inst"},"measureTemplate":{"size":"60","type":"cone","color":null,"texture":null},"name":"Use","save":{"dc":"10 + floor(@attributes.hd.total / 2) + @abilities.con.mod + 1","description":"Reflex for half","type":"ref","harmless":false},"uses":{},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"uses":{"value":5,"per":"round","autoDeductChargesCost":"1d4 + 1","maxFormula":"5","rechargeFormula":"@item.uses.value + 1"},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"su","associations":{"classes":[]},"showInQuickbar":true,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"showInCombat":true,"sources":[{"id":"PZO1112","pages":"298"},{"id":"PZO1116","pages":"294"},{"id":"PZO1120","pages":"292"},{"id":"PZO1127","pages":"290"},{"id":"PZO1133","pages":"290"},{"id":"PZO1137","pages":"291"}]},"type":"feat","effects":[],"sort":312500,"flags":{"core":{"sourceId":"Compendium.pf1.monster-abilities.Item.bg2m81Euc7kGdiKN"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"I7mJu6CocV05qegp","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125015842,"modifiedTime":1795125017208,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"folder":"xPJd6syoxDiunnzG","img":"icons/commodities/claws/claw-bear-brown-grey.webp","name":"Claw","system":{"description":{"value":"<p>A primary natural weapon using your claws on your forelimbs or arms.</p><p>It deals bludgeoning and slashing damage, whichever is most beneficial.</p><hr /><p>For general rules on natural attacks, see: @UUID[Compendium.pf1.pf1e-rules.nBnUY0koBzXqoEft.JournalEntryPage.8zivKFrhTVkbtjm3]{Natural Attacks} (UMR).</p>","instructions":""},"tags":[],"actions":[{"_id":"4lo88d47gxkw8wts","ability":{"attack":"str","damage":"str","damageMult":1.5,"critRange":20,"critMult":2},"actionType":"mwak","activation":{"type":"attack","unchained":{"type":"attack","cost":1},"cost":1},"damage":{"parts":[{"formula":"sizeRoll(1, 4, @size)","types":["bludgeoning","slashing"]}]},"name":"Attack","range":{"units":"melee"},"tag":"claw","uses":{},"powerAttack":{"damageBonus":2,"critMultiplier":1},"extraAttacks":{"type":"custom","manual":[{"name":"2nd Claw"}],"formula":{}},"naturalAttack":{"primary":true,"secondary":{"attackBonus":"-5","damageMult":1.5}}}],"attackNotes":[],"effectNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","flags":{"boolean":{},"dictionary":{}},"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"scriptCalls":[],"masterwork":false,"enh":0,"proficient":true,"held":"2h","ammo":{"type":"","capacity":null,"misfire":null,"explode":null},"subType":"natural","baseTypes":["Claw"],"broken":false,"weaponGroups":["natural"],"showInQuickbar":true,"size":"med","material":{"base":{"value":"steel"},"normal":{"value":null},"addon":[]},"class":null},"type":"attack","effects":[],"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.monster-abilities.Item.MZnbCVzqpvPsMvfT"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"name":"Ecology","type":"feat","system":{"description":{"value":"<div><strong>Environment</strong>:   any (elemental planes)</div><div><strong>Organization</strong>