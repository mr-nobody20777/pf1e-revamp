,"disposition":false},"movementAction":null,"flags":{},"randomImg":false,"appendNumber":false,"prependAdjective":false},"items":[{"name":"Docile","type":"feat","system":{"description":{"value":"<p>Unless specifically trained for combat (see the Handle Animal skill on page 97 of the Pathfinder RPG Core Rulebook), a horse's hooves are treated as secondary attacks.  Horses stand 5 to 6 feet tall at the shoulder and weigh between 1,000 and 1,500 pounds.   </p>","instructions":""},"tags":[],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"ex","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{}},"img":"systems/pf1/icons/skills/yellow_36.jpg","_id":"ff6Fx1DSIL2swzMB","effects":[],"folder":null,"sort":112500,"flags":{},"_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124822420,"modifiedTime":1795124825789,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"name":"Animal","type":"race","system":{"description":{"value":"<p>An animal is a living, nonhuman creature, usually a vertebrate with no magical abilities and no innate capacity for language or culture. Animals usually have additional information on how they can serve as companions.</p>\n<h2>Features</h2>\n<p>An animal has the following features (unless otherwise noted).</p>\n<ul>\n<li>d8 Hit Die.</li>\n<li>Base attack bonus equal to 3/4 total Hit Dice (medium progression).</li>\n<li>Good <em>Fortitude</em> and <em>Reflex</em> saves.</li>\n<li>Skill points equal to 2 + <em>Int</em> modifier (minimum 1) per Hit Die. The following are class skills for animals: <em>Acrobatics</em>, <em>Climb</em>, <em>Fly</em>, <em>Perception</em>, <em>Stealth</em>, and <em>Swim</em>.</li>\n</ul>\n<h2>Traits</h2>\n<p>An animal possesses the following traits (unless otherwise noted in a creature’s entry).</p>\n<ul>\n<li><em>Intelligence</em> score of 1 or 2 (no creature with an <em>Intelligence</em> score of 3 or higher can be an animal).</li>\n<li><em>Low-light vision</em>.</li>\n<li>Alignment: Always neutral.</li>\n<li>Treasure: None.</li>\n<li>Proficient with its natural weapons only. A non-combative herbivore treats its natural weapons as secondary attacks. Such attacks are made with a –5 penalty on the creature’s attack rolls, and the animal receives only 1/2 its <em>Strength</em> modifier as a damage adjustment.</li>\n<li>Proficient with no armor unless trained for war. (See <em>FAQ</em>s and <em>Handle Animal Skill</em>.)</li>\n<li>Animals breathe, eat, and sleep.</li>\n</ul>","instructions":""},"tags":[],"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"supplements":[]},"armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"size":"lg","speeds":{"land":null,"fly":null,"flyManeuverability":"","swim":null,"climb":null,"burrow":null},"creatureTypes":["animal"],"creatureSubtypes":[""],"sources":[]},"img":"systems/pf1/icons/skills/blue_29.jpg","_id":"qkgmV78Ee1GQYR1p","effects":[],"folder":null,"sort":112500,"flags":{},"_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124822604,"modifiedTime":1795124825789,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"_id":"td2tpcDRPVKQaGIg","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124822670,"modifiedTime":1795124825789,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/skills/blue_29.jpg","name":"Animal","system":{"description":{"value":"<p>An animal is a living, nonhuman creature, usually a vertebrate with no magical abilities and no innate capacity for language or culture. Animals usually have additional information on how they can serve as companions.</p>\n<h2>Features</h2>\n<p>An animal has the following features (unless otherwise noted).</p>\n<ul>\n<li>d8 Hit Die.</li>\n<li>Base attack bonus equal to 3/4 total Hit Dice (medium progression).</li>\n<li>Good <em>Fortitude</em> and <em>Reflex</em> saves.</li>\n<li>Skill points equal to 2 + <em>Int</em> modifier (minimum 1) per Hit Die. The following are class skills for animals: <em>Acrobatics</em>, <em>Climb</em>, <em>Fly</em>, <em>Perception</em>, <em>Stealth</em>, and <em>Swim</em>.</li>\n</ul>\n<h2>Traits</h2>\n<p>An animal possesses the following traits (unless otherwise noted in a creature’s entry).</p>\n<ul>\n<li><em>Intelligence</em> score of 1 or 2 (no creature with an <em>Intelligence</em> score of 3 or higher can be an animal).</li>\n<li><em>Low-light vision</em>.</li>\n<li>Alignment: Always neutral.</li>\n<li>Treasure: None.</li>\n<li>Proficient with its natural weapons only. A non-combative herbivore treats its natural weapons as secondary attacks. Such attacks are made with a –5 penalty on the creature’s attack rolls, and the animal receives only 1/2 its <em>Strength</em> modifier as a damage adjustment.</li>\n<li>Proficient with no armor unless trained for war. (See <em>FAQ</em>s and <em>Handle Animal Skill</em>.)</li>\n<li>Animals breathe, eat, and sleep.</li>\n</ul>","instructions":""},"tags":[],"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"classAssociations":[],"supplements":[]},"tag":"animal","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"racial","level":2,"hd":8,"hp":9,"bab":"med","skillsPerLevel":2,"savingThrows":{"fort":{"value":"high"},"ref":{"value":"high"},"will":{"value":"low"}},"fc":{"hp":{"value":0},"skill":{"value":0},"alt":{"value":0,"notes":""}},"wealth":"","alignment":"","classSkills":{"acr":true,"clm":true,"fly":true,"per":true,"ste":true,"swm":true}},"type":"class","effects":[],"folder":null,"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.racial-hd.Item.WJqmmfXscPVpcISH"}},"ownership":{"default":0}},{"_id":"zAV3DeVxKTNElQVB","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124823025,"modifiedTime":1795124825789,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/endurance.png","name":"Endurance","system":{"description":{"value":"<i>Harsh conditions or long exertions do not easily tire you.</i><p><strong>Benefits</strong>: You gain a +4 bonus on the following checks and saves: Swim checks made to resist nonlethal damage from exhaustion; Constitution checks made to continue running; Constitution checks made to avoid nonlethal damage from a forced march; Constitution checks made to hold your breath; Constitution checks made to avoid nonlethal damage from starvation or thirst; Fortitude saves made to avoid nonlethal damage from hot or cold environments; and Fortitude saves made to resist damage from suffocation.</p><p>You may sleep in light or medium armor without becoming fatigued.</p><p><strong>Normal</strong>: A character without this feat who sleeps in medium or heavier armor is fatigued the next day.</p>","instructions":""},"tags":["General"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"115, 122"}]},"type":"feat","effects":[],"folder":null,"sort":312500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.ehqx8txNRGMaNOPt"}},"ownership":{"default":0}},{"_id":"OZF6p1Yos7G7l8co","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124823063,"modifiedTime":1795124825789,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/run.jpg","name":"Run","system":{"description":{"value":"<p><em>You are swift of foot.</em></p><p><strong>Benefits</strong>: When running, you move five times your normal speed (if wearing medium, light, or no armor and carrying no more than a medium load) or four times your speed (if wearing heavy armor or carrying a heavy load). If you make a jump after a running start (see the Acrobatics skill description), you gain a +4 bonus on your Acrobatics check. While running, you retain your Dexterity bonus to your Armor Class.</p><p><strong>Normal</strong>: You move four times your speed while running (if wearing medium, light, or no armor and carrying no more than a medium load) or three times your speed (if wearing heavy armor or carrying a heavy load), and you lose your Dexterity bonus to AC.</p>","instructions":""},"tags":["General"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[{"target":"skill.acr","text":"+[[4]] to jump after a running start"}],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"116, 132"}]},"type":"feat","effects":[],"folder":null,"sort":512500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.bXeW4kLCErPBFpNB"}},"ownership":{"default":0}},{"name":"Hooves -2","type":"attack","img":"systems/pf1/icons/items/weapons/elven-curve-blade.PNG","system":{"description":{"value":"","instructions":""},"tags":[],"actions":[{"activation":{"cost":1,"type":"attack","unchained":{"cost":1,"type":"attack"}},"actionType":"mwak","_id":"gLvKmmcZxMGVqo1b","name":"Hooves -2","img":"systems/pf1/icons/items/weapons/elven-curve-blade.PNG","range":{"units":"melee"},"uses":{},"attackName":"Hooves -2","damage":{"parts":[{"formula":"sizeRoll(1, 4, @size, 5)","types":["untyped"]}]},"extraAttacks":{"type":"custom","manual":[{"name":"2nd Hooves -2"}],"formula":{"count":"","bonus":"@formulaicAttack * -5","label":""}},"ability":{"attack":"str","damag