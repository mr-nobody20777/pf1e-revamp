ffsetFormula":"","preparedOffsetFormula":""},"spell9":{"castPerDayOffsetFormula":"","preparedOffsetFormula":""}},"spellSlotAbilityBonusFormula":"","domainSlotValue":1}}},"cmb":{}},"details":{"height":"","weight":"","gender":"","deity":"","age":"","alignment":"tn","biography":{"value":""},"bonusFeatFormula":"","bonusSkillRankFormula":"","carryCapacity":{"bonus":{"user":0},"multiplier":{"base":1,"user":0}},"notes":{"value":"<div style=\"margin-top:15px;margin-bottom:5px;text-align:center;font-size:1em;font-weight:900\"><p>sbc | Generated with version 6.0.3 on November 19, 2026</p></div><hr /><div class=\"statblockContainer\" style=\"margin-top:15px\"><p></p><div class=\"sbcStatBlock\"><hr class=\"sbcBorder\" /><div style=\"padding:5px\"><h1>Dire Bear <ul class=\"sbcSlashList\">   </ul></h1>  <hr /><div class=\"sbcSection\" data-content=\"base\"> <strong>Source</strong> PFRPG Bestiary<br /> <strong>XP</strong> 3,200<br />     <br /> N  Large  Animal  <ul class=\"sbcCommaList sbcParensWrappedList\">    </ul><br /><ul class=\"sbcSemicolonList\"><li><strong>Init</strong>  +5</li>  <li><strong>Senses</strong><ul class=\"sbcCommaList\" data-content=\"senses\">  <li>Low-light</li>  <li>Scent 0 ft</li>  </ul></li>   <span><strong>Perception</strong> +12</span>  </ul><br />  </div><div class=\"sbcSection\" data-content=\"defense\"><h4>Defense</h4><hr /><ul class=\"sbcCommaList\"><li><strong>AC</strong> 18</li><li><strong>Touch</strong> 10</li><li><strong>Flat-footed</strong> 17</li></ul>  <ul class=\"sbcParensWrappedList sbcCommaList\" data-group=\"armor\">  <li>+1 Dex</li>  <li>+8 Natural</li>  <li>-1 Size</li>  </ul>  <br /><ul class=\"sbcSemicolonList\"><li><strong>Hit Points</strong> 95 (10 HD; 10d8+50)</li>  </ul><br /><ul class=\"sbcSemicolonList\"><li><ul class=\"sbcCommaList\" data-content=\"saves\"><li><strong>Fort</strong> +12</li><li><strong>Ref</strong> +8</li><li><strong>Will</strong> +4</li></ul></li>   </ul><br /><ul class=\"sbcSemicolonList\">       </ul>  </div><div><div class=\"sbcSection\" data-content=\"offense\"><h4>Offense</h4><hr /><strong>Speed</strong><ul class=\"sbcCommaList\" data-content=\"speed\">  <li>Land 40 ft</li>  </ul><br />  <strong>Melee</strong> 2 claws +13 (1d6+7 plus grab), bite +13 (1d8+7)<br />   <ul class=\"sbcSemicolonList\">  <li><strong>Space</strong> 10 ft</li>   <li><strong>Reach</strong> 5 ft</li>  </ul> <br />  </div></div>    <div class=\"sbcSection\" data-content=\"statistics\"><h4>Statistics</h4><hr /><ul class=\"sbcCommaList\" data-content=\"attributes\"><li><strong>Str</strong> 25</li><li><strong>Dex</strong> 13</li><li><strong>Con</strong> 21</li><li><strong>Int</strong> 2</li><li><strong>Wis</strong> 12</li><li><strong>Cha</strong> 10</li></ul><br /><ul class=\"sbcSemicolonList\" data-content=\"base-attack\"><li><strong>Base Atk</strong>+7</li><li><strong>CMB</strong> +15 (+19 grapple)</li><li><strong>CMD</strong> 26  (30 vs. trip) </li></ul><br />  <strong>Feats</strong><ul class=\"sbcCommaList\" data-content=\"feats\">  <li>Endurance</li>  <li>Improved Initiative</li>  <li>Iron Will</li>  <li>Run</li>  <li>Skill Focus <ul class=\"sbcCommaList sbcParensWrappedList\">  <li>Perception</li>  </ul></li>  </ul><br />   <strong>Skills</strong><ul class=\"sbcCommaList\" data-content=\"skills\">  <li>Perception +12</li>  <li>Swim +19</li>  </ul>  <br />     </div>  <div class=\"sbcSection\" data-content=\"ecology\"><h4>Ecology</h4><hr />  <strong>Environment</strong>   cold forests <br />   <strong>Organization</strong>  solitary or pair <br />   <strong>Treasure</strong>  incidental   <br />  </div>      <div class=\"sbcSection\" data-content=\"description\"><h4> Description </h4><hr /><div class=\"sbcPreWrap\">\nLarger, more aggressive, and far more deadly than its lesser cousins, the dire bear (known to barbarian tribes variously as the cave bear or the short-faced bear) is a primeval menace indeed.\n\nThis behemoth avoids more civilized reaches of the world, preferring to dwell in remote wilderness locations.\n\nA dire bear is a rare and terrifying sight- especially to those not used to normal bears.\n\nUnlike most bears, a dire bear is short-tempered and swift to anger when confronted with intruders in its territory.\n\nLike a grizzly, a dire bear attempts to subdue or kill with its claws.\n\nHowever, a dire bear is far more likely (and willing) to begin biting a grabbed foe.\n</div></div>  </div><hr class=\"sbcBorder\" /></div><p></p></div><br /><hr /><div class=\"rawInputContainer\" style=\"margin-top:15px\"><h2 style=\"text-align:middle;border:none;text-transform:uppercase;color:#000\">RAW INPUT</h2><hr /><pre style=\"white-space:pre-wrap;font-size:14px\">    Dire Bear (CR 7)\nSource PFRPG Bestiary \nCR 7 \nXP 3,200 \nN Large animal  \nInit +5; Senses low-light vision, scent; Perception +12   \nDefense   \nAC 18, touch 10, flat-footed 17 (+1 Dex, +8 natural, -1 size)\n\nhp 95 (10d8+50)\n\nFort +12, Ref +8, Will +4   \nOffense   \nSpd 40 ft. \nMelee 2 claws +13 (1d6+7 plus grab), bite +13 (1d8+7)\n\nSpace 10 ft.; Reach 5 ft.   \nStatistics   \nStr 25, Dex 13, Con 21, Int 2, Wis 12, Cha 10 \nBase Atk +7; CMB +15 (+19 grapple); CMD 26 (30 vs. trip)\n\nFeats Endurance, Improved Initiative, Iron Will, Run, Skill Focus (Perception)\n\nSkills Perception +12, Swim +19; Racial Modifiers +4 Swim   \nEcology   \nEnvironment  cold forests \nOrganization solitary or pair \nTreasure incidental   \nDescription\n\nLarger, more aggressive, and far more deadly than its lesser cousins, the dire bear (known to barbarian tribes variously as the cave bear or the short-faced bear) is a primeval menace indeed.\n\nThis behemoth avoids more civilized reaches of the world, preferring to dwell in remote wilderness locations.\n\nA dire bear is a rare and terrifying sight- especially to those not used to normal bears.\n\nUnlike most bears, a dire bear is short-tempered and swift to anger when confronted with intruders in its territory.\n\nLike a grizzly, a dire bear attempts to subdue or kill with its claws.\n\nHowever, a dire bear is far more likely (and willing) to begin biting a grabbed foe.\n    </pre></div>"},"cr":{"base":7},"xp":{"value":0}},"skills":{"acr":{"ability":"dex","rt":false,"acp":true,"rank":0},"apr":{"ability":"int","rt":false,"acp":false,"rank":0},"art":{"ability":"int","rt":false,"acp":false,"rank":0},"blf":{"ability":"cha","rt":false,"acp":false,"rank":0},"clm":{"ability":"str","rt":false,"acp":true,"rank":0},"crf":{"ability":"int","rt":false,"acp":false,"rank":0},"dip":{"ability":"cha","rt":false,"acp":false,"rank":0},"dev":{"ability":"dex","rt":true,"acp":true,"rank":0},"dis":{"ability":"cha","rt":false,"acp":false,"rank":0},"esc":{"ability":"dex","rt":false,"acp":true,"rank":0},"fly":{"ability":"dex","rt":false,"acp":true,"rank":0},"han":{"ability":"cha","rt":true,"acp":false,"rank":0},"hea":{"ability":"wis","rt":false,"acp":false,"rank":0},"int":{"ability":"cha","rt":false,"acp":false,"rank":0},"kar":{"ability":"int","rt":true,"acp":false,"rank":0},"kdu":{"ability":"int","rt":true,"acp":false,"rank":0},"ken":{"ability":"int","rt":true,"acp":false,"rank":0},"kge":{"ability":"int","rt":true,"acp":false,"rank":0},"khi":{"ability":"int","rt":true,"acp":false,"rank":0},"klo":{"ability":"int","rt":true,"acp":false,"rank":0},"kna":{"ability":"int","rt":true,"acp":false,"rank":0},"kno":{"ability":"int","rt":true,"acp":false,"rank":0},"kpl":{"ability":"int","rt":true,"acp":false,"rank":0},"kre":{"ability":"int","rt":true,"acp":false,"rank":0},"lin":{"ability":"int","rt":true,"acp":false,"rank":0},"lor":{"ability":"int","rt":true,"acp":false,"rank":0},"per":{"ability":"wis","rt":false,"acp":false,"rank":5},"prf":{"ability":"cha","rt":false,"acp":false,"rank":0},"pro":{"ability":"wis","rt":true,"acp":false,"rank":0},"rid":{"ability":"dex","rt":false,"acp":true,"rank":0},"sen":{"ability":"wis","rt":false,"acp":false,"rank":0},"slt":{"ability":"dex","rt":true,"acp":true,"rank":0},"spl":{"ability":"int","rt":true,"acp":f