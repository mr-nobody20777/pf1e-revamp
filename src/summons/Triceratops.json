/li>\n<li>Proficient with no armor unless trained for war. (See <em>FAQ</em>s and <em>Handle Animal Skill</em>.)</li>\n<li>Animals breathe, eat, and sleep.</li>\n</ul>","instructions":""},"tags":[],"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"classAssociations":[],"supplements":[]},"tag":"animal","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"racial","level":14,"hd":8,"hp":63,"bab":"med","skillsPerLevel":2,"savingThrows":{"fort":{"value":"high"},"ref":{"value":"high"},"will":{"value":"low"}},"fc":{"hp":{"value":0},"skill":{"value":0},"alt":{"value":0,"notes":""}},"wealth":"","alignment":"","classSkills":{"acr":true,"clm":true,"fly":true,"per":true,"ste":true,"swm":true}},"type":"class","effects":[],"folder":null,"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.racial-hd.Item.WJqmmfXscPVpcISH"}},"ownership":{"default":0}},{"_id":"q1aARo7XkdN5sPTj","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795125172961,"modifiedTime":1795125175780,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/great-fortitude.jpg","name":"Great Fortitude","system":{"description":{"value":"<i>You are resistant to poisons, diseases, and other maladies.</i>\n<p><b>Benefits</b></p>\n<p>You get a +2 bonus on all Fortitude saving throws.</p>","instructions":""},"tags":["General","Saving Throw","Defensive"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[{"_id":"PKs9PQxF","formula":"2","target":"fort","type":"untyped","operator":"add","priority":0}],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncu