eInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"ex","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{}},"img":"systems/pf1/icons/skills/yellow_36.jpg","_id":"cfb6h0XNGcxdRlLf","effects":[],"folder":null,"sort":712500,"flags":{},"_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124942048,"modifiedTime":1795124945333,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"name":"Outsider","type":"race","system":{"description":{"value":"<p>An outsider is at least partially composed of the essence (but not necessarily the material) of some plane other than the Material Plane. Some creatures start out as some other type and become outsiders when they attain a higher (or lower) state of spiritual existence.</p>\n<h2>Features</h2>\n<p>An outsider has the following features.</p>\n<ul>\n<li>d10 Hit Dice.</li>\n<li>Base attack bonus equal to total Hit Dice (fast progression).</li>\n<li>Two good saving throws, usually <em>Reflex</em> and Will.</li>\n<li>Skill points equal to 6 + Int modifier (minimum 1) per Hit Die. The following are class skills for outsiders: <em>Bluff</em>, <em>Craft</em>, <em>Knowledge</em> (planes), <em>Perception</em>, <em>Sense Motive</em>, and <em>Stealth</em>. Due to their varied nature, outsiders also receive 4 additional class skills determined by the creature’s theme.</li>\n</ul>\n<h2>Traits</h2>\n<p>An outsider possesses the following traits (unless otherwise noted in a creature’s entry).</p>\n<ul>\n<li>Darkvision 60 feet.</li>\n<li>Unlike most living creatures, an outsider does not have a dual nature—its soul and body form one unit. When an outsider is slain, no soul is set loose. Spells that restore souls to their bodies, such as <em>raise dead</em>, <em>reincarnate</em>, and <em>resurrection</em>, don’t work on an outsider. It takes a different magical effect, such as <em>limited wish</em>, <em>wish</em>, <em>miracle</em>, or <em>true resurrection</em> to restore it to life. An outsider with the native subtype can be raised, reincarnated, or resurrected just as other living creatures can be.</li>\n<li>Proficient with all simple and martial weapons and any weapons mentioned in its entry.</li>\n<li>Proficient with whatever type of armor (light, medium, or heavy) it is described as wearing, as well as all lighter types. Outsiders not indicated as wearing armor are not proficient with armor. Outsiders are proficient with shields if they are proficient with any form of armor.</li>\n<li>Outsiders breathe, but do not need to eat or sleep (although they can do so if they wish). Native outsiders breathe, eat, and sleep.</li>\n</ul>","instructions":""},"tags":[],"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"supplements":[]},"armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"size":"med","speeds":{"land":null,"fly":null,"flyManeuverability":"","swim":null,"climb":null,"burrow":null},"creatureTypes":["outsider"],"creatureSubtypes":["elemental","extraplanar","water"],"sources":[{"id":"PZO1112","pages":"309"}]},"img":"systems/pf1/icons/skills/yellow_40.jpg","_id":"KT0JM7FiM7rhWASx","effects":[],"folder":null,"sort":112500,"flags":{},"_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124942204,"modifiedTime":1795124945333,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"ownership":{"default":0}},{"_id":"c8Bwet7qGBazZGeJ","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124942264,"modifiedTime":1795124945333,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/skills/yellow_40.jpg","name":"Outsider","system":{"description":{"value":"<p>An outsider is at least partially composed of the essence (but not necessarily the material) of some plane other than the Material Plane. Some creatures start out as some other type and become outsiders when they attain a higher (or lower) state of spiritual existence.</p>\n<h2>Features</h2>\n<p>An outsider has the following features.</p>\n<ul>\n<li>d10 Hit Dice.</li>\n<li>Base attack bonus equal to total Hit Dice (fast progression).</li>\n<li>Two good saving throws, usually <em>Reflex</em> and Will.</li>\n<li>Skill points equal to 6 + Int modifier (minimum 1) per Hit Die. The following are class skills for outsiders: <em>Bluff</em>, <em>Craft</em>, <em>Knowledge</em> (planes), <em>Perception</em>, <em>Sense Motive</em>, and <em>Stealth</em>. Due to their varied nature, outsiders also receive 4 additional class skills determined by the creature’s theme.</li>\n</ul>\n<h2>Traits</h2>\n<p>An outsider possesses the following traits (unless otherwise noted in a creature’s entry).</p>\n<ul>\n<li>Darkvision 60 feet.</li>\n<li>Unlike most living creatures, an outsider does not have a dual nature—its soul and body form one unit. When an outsider is slain, no soul is set loose. Spells that restore souls to their bodies, such as <em>raise dead</em>, <em>reincarnate</em>, and <em>resurrection</em>, don’t work on an outsider. It takes a different magical effect, such as <em>limited wish</em>, <em>wish</em>, <em>miracle</em>, or <em>true resurrection</em> to restore it to life. An outsider with the native subtype can be raised, reincarnated, or resurrected just as other living creatures can be.</li>\n<li>Proficient with all simple and martial weapons and any weapons mentioned in its entry.</li>\n<li>Proficient with whatever type of armor (light, medium, or heavy) it is described as wearing, as well as all lighter types. Outsiders not indicated as wearing armor are not proficient with armor. Outsiders are proficient with shields if they are proficient with any form of armor.</li>\n<li>Outsiders breathe, but do not need to eat or sleep (although they can do so if they wish). Native outsiders breathe, eat, and sleep.</li>\n</ul>","instructions":""},"tags":[],"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"classAssociations":[],"supplements":[]},"tag":"outsider","armorProf":[],"weaponProf":["simple","martial"],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"racial","level":4,"hd":10,"hp":22,"bab":"high","skillsPerLevel":6,"savingThrows":{"fort":{"value":"high"},"ref":{"value":"high"},"will":{"value":"low"}},"fc":{"hp":{"value":0},"skill":{"value":0},"alt":{"value":0,"notes":""}},"wealth":"","alignment":"","classSkills":{"blf":true,"crf":true,"kpl":true,"per":true,"sen":true,"ste":true,"acr":true,"esc":true,"swm":true},"sources":[{"id":"PZO1112","pages":"309"}]},"type":"class","effects":[],"folder":null,"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.racial-hd.Item.cV7yHt8i5YCV0ZTd"}},"ownership":{"default":0}},{"_id":"E9neZSx6FluqrVxj","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124942614,"modifiedTime":1795124945333,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/cleave.jpg","name":"Cleave","system":{"description":{"value":"<p><em>You can strike two adjacent foes with a single swing.</em></p><p><strong>Prerequisites</strong>: Str 13, @UUID[Compendium.pf1.feats.Item.FUW5mIXHNBBIQ1Sq]{Power Attack}, base attack bonus +1.</p><p><strong>Benefits</strong>: As a standard action, you can make a single attack at your full base attack bonus against a foe within reach. If you hit, you deal damage normally and can make an additional attack (using your full base attack bonus) against a foe that is adjacent to the first and also within reach. You can only make one additional attack per round with this feat. When you use this feat, you take a -2 penalty to your Armor Class until your next turn.</p><h3>Combat Trick</h3><p>When using the Cleave or Great Cleave feat, you can spend 4 stamina points to negate the -2 penalty to Armor Class until your next turn.</p>","instructions":""},"tags":["Combat","Combat Trick"],"actions":[{"_id":"YKPDCAoDrghiYAzi","activation":{"type":"standard","unchained":{"cost":2,"type":"action"},"cost":1},"name":"Use","notes":{"effect":["[[-2]] penalty to your Armor Class until your next turn."]},"actionType":"other","uses":{},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1110","pages":"116, 119"}]},"type":"feat","effects":[],"folder":null,"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.Zeq6RWYv5otvg8q7"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"u0jvxyWWLX6vHHr6","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124942653,"modifiedTime":1795124945333,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/power-attack.jpg","name":"Power Attack","system":{"description":{"value":"<i>You can make exceptionally deadly melee attacks by sacrificing accuracy for strength.</i><p><strong>Prerequisites</strong>: Str 13, base attack bonus +1.</p><p><strong>Benefits</strong>: You can choose to take a -1 penalty on all melee attack rolls and combat maneuver checks to gain a +2 bonus on all melee damage rolls. This bonus to damage is increased by half (+50%) if you are making an attack with a two-handed weapon, a one handed weapon using two hands, or a primary natural weapon that adds 1-1/2 times your Strength modifier on damage rolls. This bonus to damage is halved (-50%) if you are making an attack with an off-hand weapon or secondary natural weapon. When your base attack bonus reaches +4, and every 4 points thereafter, the penalty increases by -1 and the bonus to damage increases by +2. You must choose to use this feat before making an attack roll, and its effects last until your next turn. The bonus damage does not apply to touch attacks or effects that do not deal hit point damage.</p>","instructions":""},"tags":["Combat","Offensive"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls