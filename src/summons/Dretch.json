t":2},"actionType":"mwak","activation":{"type":"attack","unchained":{"type":"attack","cost":1},"cost":1},"damage":{"parts":[{"formula":"sizeRoll(1, 6, @size)","types":["piercing","bludgeoning","slashing"]}]},"img":"systems/pf1/icons/skills/red_29.jpg","name":"Attack","range":{"units":"melee"},"tag":"bite","uses":{},"powerAttack":{"damageBonus":2,"critMultiplier":1},"extraAttacks":{"type":"custom","formula":{}},"naturalAttack":{"primary":true,"secondary":{"attackBonus":"-5","damageMult":1.5}}}],"attackNotes":[],"effectNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","flags":{"boolean":{},"dictionary":{}},"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"scriptCalls":[],"masterwork":false,"enh":0,"proficient":true,"held":"2h","ammo":{"type":"","capacity":null,"misfire":null,"explode":null},"subType":"natural","baseTypes":["Bite"],"broken":false,"weaponGroups":["natural"],"showInQuickbar":true,"size":"med","material":{"base":{"value":"steel"},"normal":{"value":null},"addon":[]},"class":null},"type":"attack","effects":[],"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.monster-abilities.Item.szjeStouwI3F3WdP"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"EnWvvhgZsuaCew43","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124570652,"modifiedTime":1795124572308,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/skills/blue_26.jpg","name":"Summon (level , 1 dretch 35%)","system":{"description":{"value":"<p>A creature with the summon ability can summon other specific creatures of its kind much as though casting a <a>summon monster</a> spell, but it usually has only a limited chance of success (as specified in the creature’s entry). Roll d%; on a failure, no creature answers the summons. Summoned creatures automatically return to wherever they came from after 1 hour. A creature summoned in this way cannot use any spells or spell-like abilities that require material components costing more than 1 gp unless those components are supplied, nor can it use its own summon ability for 1 hour. An appropriate spell level is given for each summoning ability for the purposes of caster level checks, concentration checks, and Will saves. No experience points are awarded for defeating summoned monsters.</p><p><em>Format</em>: 1/day—summon (level 4, 1 <a href=\"https://www.aonprd.com/MonsterDisplay.aspx?ItemName=Hezrou\">hezrou</a> 35%)</p><p><em>Location</em>: Spell-Like Abilities.</p>","instructions":""},"tags":["Universal Monster Rules"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":1,"per":"day","autoDeductChargesCost":"","maxFormula":"1","rechargeFormula":"","max":1},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"misc","traitType":"","traitCategory":"","racePoints":null,"abilityType":"sp","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{}},"type":"feat","effects":[],"folder":null,"sort":312500,"flags":{"core":{"sourceId":"Compendium.pf-content.pf-universal-monster-rules.Item.iDvNySIdxxIWPM6g"}},"ownership":{"default":0}},{"_id":"NOz6gBaT0WVkGzHM","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124570687,"modifiedTime":1795124572394,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"folder":"9hBqwSiT8GIHl0Ht","img":"icons/creatures/magical/spirit-fear-energy-pink.webp","name":"Cause Fear","system":{"description":{"value":"<p>The affected creature becomes frightened. If the subject succeeds on a Will save, it is shaken for 1 round. Creatures with 6 or more HD are immune to this effect. Cause fear counters and dispels remove fear.</p>","instructions":""},"tags":[],"actions":[{"_id":"ucbil3spn3e1y1e3","actionType":"spellsave","activation":{"type":"standard","unchained":{"cost":2,"type":"action"},"cost":1},"duration":{"units":"spec","value":"1d4 rounds or 1 round; see text"},"name":"Use","range":{"units":"close"},"save":{"description":"Will partial","type":"will","harmless":false,"dc":"0"},"target":{"value":"one living creature with 5 or fewer HD"},"uses":{},"ability":{"critRange":20,"critMult":2},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"links":{"children":[],"supplements":[]},"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"learnedAt":{"class":{"adept":1,"antipaladin":1,"arcanist":1,"bard":1,"bloodrager":1,"cleric":1,"inquisitor":1,"medium":1,"mesmerist":1,"occultist":1,"oracle":1,"psychic":1,"shaman":1,"skald":1,"sorcerer":1,"spiritualist":1,"warpriest":1,"witch":1,"wizard":1},"domain":{"Death":1},"subDomain":{"Daemon":1,"Fear":1},"elementalSchool":{},"bloodline":{"Abyssal":1}},"level":1,"clOffset":0,"slOffset":0,"school":"nec","subschool":[],"descriptors":["emotion","fear","mindAffecting"],"components":{"value":"","verbal":true,"somatic":true,"thought":false,"emotion":false,"material":false,"focus":false,"divineFocus":0},"materials":{"value":"","focus":"","gpValue":0},"spellbook":"primary","preparation":{"value":0,"max":0},"uses":{"autoDeductChargesCost":"","max":1,"value":1,"per":""},"atWill":false,"sr":true,"showInQuickbar":false,"domain":false,"slotCost":1,"sources":[{"id":"PZO1110","pages":"252"}],"spellPoints":{"cost":"1 + @sl"}},"type":"spell","effects":[],"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.spells.Item.9tww9fc9049h6iqc"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"fUtjTwn2jBhuCLFH","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795124570727,"modifiedTime":1795124572394,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"folder":"Ix6Dc5gXEobiIHKD","img":"icons/magic/air/fog-gas-smoke-green.webp","name":"Stinking Cloud","system":{"description":{"value":"<p><i>Stinking cloud</i> creates a bank of fog like that created by <i>fog cloud</i>, except that the vapors are nauseating. Living creatures in the cloud become nauseated. This condition lasts as long as the creature is in the cloud and for 1d4+1 rounds after it leaves.</p><p>(Roll separately for each nauseated character.) Any creature that succeeds on its save but remains in the cloud must continue to save each round on your turn. This is a poison effect.</p><p><i>Stinking cloud</i> can be made permanent with a <i>permanency</i> spell. A permanent <i>stinking cloud</i> dispersed by wind reforms in 10 minutes.</p>","instructions":""},"tags":[],"actions":[{"_id":"pt2uaa5onc9bwk56","actionType":"spellsave","activation":{"type":"standard","unchained":{"cost":2,"type":"action"},"cost":1},"duration":{"units":"round","value":"@cl"},"effect":"cloud spreads in 20-ft. radius, 20 ft. high","name":"Use","range":{"units":"medium"},"save":{"description":"Fortitude negates; see text","type":"fort","harmless":false,"dc":"0"},"uses":{},"ability":{"critRange":20,"critMult":2},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"links":{"children":[],"supplements":[]},"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"learnedAt":{"class":{"arcanist":3,"bloodrager":3,"magus":3,"shaman":3,"sorcerer":3,"summonerUnchained":3,"witch":3,"wizard":3},"domain":{},"subDomain":{"Smoke":3},"elementalSchool":{},"bloodline":{}},"level":3,"clOffset":0,"slOffset":0,"school":"con","subschool":["creation"],"descriptors":[],"components":{"value":"","verbal":true,"somatic":true,"thought":false,"emotion":false,"material":true,"focus":false,"divineFocus":0},"materials":{"value":"a rotten eg