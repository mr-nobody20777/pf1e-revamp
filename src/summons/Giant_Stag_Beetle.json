la":""},"spell8":{"castPerDayOffsetFormula":"","preparedOffsetFormula":""},"spell9":{"castPerDayOffsetFormula":"","preparedOffsetFormula":""}},"spellSlotAbilityBonusFormula":"","domainSlotValue":1}}},"cmb":{}},"details":{"height":"","weight":"","gender":"","deity":"","age":"","alignment":"tn","biography":{"value":""},"bonusFeatFormula":"","bonusSkillRankFormula":"","carryCapacity":{"bonus":{"user":0},"multiplier":{"base":1,"user":0}},"notes":{"value":"<div style=\"margin-top:15px;margin-bottom:5px;text-align:center;font-size:1em;font-weight:900\"><p>sbc | Generated with version 6.0.3 on November 19, 2026</p></div><hr /><div class=\"statblockContainer\" style=\"margin-top:15px\"><p></p><div class=\"sbcStatBlock\"><hr class=\"sbcBorder\" /><div style=\"padding:5px\"><h1>Giant Stag Beetle <ul class=\"sbcSlashList\">   </ul></h1>  <hr /><div class=\"sbcSection\" data-content=\"base\"> <strong>Source</strong> PFRPG Bestiary<br /> <strong>XP</strong> 1,200<br />     <br /> N  Large  Vermin  <ul class=\"sbcCommaList sbcParensWrappedList\">    </ul><br /><ul class=\"sbcSemicolonList\"><li><strong>Init</strong>  +0</li>  <li><strong>Senses</strong><ul class=\"sbcCommaList\" data-content=\"senses\">  <li>Darkvision 60 ft</li>  </ul></li>   </ul><br />  </div><div class=\"sbcSection\" data-content=\"defense\"><h4>Defense</h4><hr /><ul class=\"sbcCommaList\"><li><strong>AC</strong> 17</li><li><strong>Touch</strong> 9</li><li><strong>Flat-footed</strong> 17</li></ul>  <ul class=\"sbcParensWrappedList sbcCommaList\" data-group=\"armor\">  <li>+8 Natural</li>  <li>-1 Size</li>  </ul>  <br /><ul class=\"sbcSemicolonList\"><li><strong>Hit Points</strong> 45 (7 HD; 7d8+14)</li>  </ul><br /><ul class=\"sbcSemicolonList\"><li><ul class=\"sbcCommaList\" data-content=\"saves\"><li><strong>Fort</strong> +7</li><li><strong>Ref</strong> +2</li><li><strong>Will</strong> +2</li></ul></li>   </ul><br /><ul class=\"sbcSemicolonList\">    <li><strong>Immune</strong><ul class=\"sbcCommaList\" data-content=\"immune\">  <li>Mind-affecting</li>  </ul></li>     </ul>  </div><div><div class=\"sbcSection\" data-content=\"offense\"><h4>Offense</h4><hr /><strong>Speed</strong><ul class=\"sbcCommaList\" data-content=\"speed\">  <li>Land 20 ft</li>  <li>Fly 20 ft (Poor)</li>  </ul><br />  <strong>Melee</strong> bite +8 (2d8+6)<br />   <ul class=\"sbcSemicolonList\">  <li><strong>Space</strong> 10 ft</li>   <li><strong>Reach</strong> 5 ft</li>  </ul> <br />  <strong>Special Attacks</strong><ul class=\"sbcCommaList\" data-content=\"special-attacks\">  <li>trample</li>  </ul><br />  </div></div>    <div class=\"sbcSection\" data-content=\"statistics\"><h4>Statistics</h4><hr /><ul class=\"sbcCommaList\" data-content=\"attributes\"><li><strong>Str</strong> 19</li><li><strong>Dex</strong> 10</li><li><strong>Con</strong> 15</li><li><strong>Int</strong>  —</li><li><strong>Wis</strong> 10</li><li><strong>Cha</strong> 9</li></ul><br /><ul class=\"sbcSemicolonList\" data-content=\"base-attack\"><li><strong>Base Atk</strong>+5</li><li><strong>CMB</strong> +10</li><li><strong>CMD</strong> 20  (28 vs. trip) </li></ul><br />   <strong>Skills</strong><ul class=\"sbcCommaList\" data-content=\"skills\">  <li>Fly -6</li>  </ul>  <br />     </div>  <div class=\"sbcSection\" data-content=\"ecology\"><h4>Ecology</h4><hr />  <strong>Environment</strong>   temperate forests <br />   <strong>Organization</strong>  solitary, pair, or cluster (3-6)<br />   <strong>Treasure</strong>  none   <br />  </div>      <div class=\"sbcSection\" data-content=\"description\"><h4> Description </h4><hr /><div class=\"sbcPreWrap\">\nNearly 10 feet long, giant stag beetles become serious dangers when they wander into logging camps due to their appetite for decaying wood. Called stag beetles because of their large, antler-like mandibles, they use these appendages to wrestle competing suitors and quickly put down enemy threats.  Variant species of these giant beetles exist as well. The two detailed below are the ones most commonly encountered.  Bombardier Beetle (CR 2): This giant stag beetle has only 2 Hit Dice and is Medium sized, but can spray acid once per round in a 10-foot cone. Those in the cone must make a DC 11 Fortitude save or take 1d4+2 points of acid damage. The save DC is Constitution-based.  Goliath Beetle (CR 8): The immense goliath beetle is a Huge stag beetle with 12 HD and the trample special ability.\n</div></div>  </div><hr class=\"sbcBorder\" /></div><p></p></div><br /><hr /><div class=\"rawInputContainer\" style=\"margin-top:15px\"><h2 style=\"text-align:middle;border:none;text-transform:uppercase;color:#000\">RAW INPUT</h2><hr /><pre style=\"white-space:pre-wrap;font-size:14px\">    Giant Stag Beetle (CR 4)\nSource PFRPG Bestiary \nCR 4 \nXP 1,200 \nN Large vermin  \nInit +0; Senses darkvision 60 ft.; Perception +0   \nDefense   \nAC 17, touch 9, flat-footed 17 (+8 natural, -1 size)\n\nhp 45 (7d8+14)\n\nFort +7, Ref +2, Will +2 \nImmune mind-affecting effects   \nOffense   \nSpd 20 ft., fly 20 ft. (poor)\n\nMelee bite +8 (2d8+6)\n\nSpace 10 ft.; Reach 5 ft. \nSpecial Attacks trample (1d6+6, DC 17)\n\n\n\nStatistics   \nStr 19, Dex 10, Con 15, Int -, Wis 10, Cha 9 \nBase Atk +5; CMB +10; CMD 20 (28 vs. trip)\n\nSkills Fly -6   \nEcology   \nEnvironment  temperate forests \nOrganization solitary, pair, or cluster (3-6)\n\nTreasure none   \nDescription\n\nNearly 10 feet long, giant stag beetles become serious dangers when they wander into logging camps due to their appetite for decaying wood. Called stag beetles because of their large, antler-like mandibles, they use these appendages to wrestle competing suitors and quickly put down enemy threats.  Variant species of these giant beetles exist as well. The two detailed below are the ones most commonly encountered.  Bombardier Beetle (CR 2): This giant stag beetle has only 2 Hit Dice and is Medium sized, but can spray acid once per round in a 10-foot cone. Those in the cone must make a DC 11 Fortitude save or take 1d4+2 points of acid damage. The save DC is Constitution-based.  Goliath Beetle (CR 8): The immense goliath beetle is a Huge stag beetle with 12 HD and the trample special ability.\n    </pre></div>"},"cr":{"base":4},"xp":{"value":0}},"skills":{"acr":{"ability":"dex","rt":false,"acp":true,"rank":0},"apr":{"ability":"int","rt":false,"acp":false,"rank":0},"art":{"ability":"int","rt":false,"acp":false,"rank":0},"blf":{"ability":"cha","rt":false,"acp":false,"rank":0},"clm":{"ability":"str","rt":false,"acp":true,"rank":0},"crf":{"ability":"int","rt":false,"acp":false,"rank":0},"dip":{"ability":"cha","rt":false,"acp":false,"rank":0},"dev":{"ability":"dex","rt":true,"acp":true,"rank":0},"dis":{"ability":"cha","rt":false,"acp":false,"rank":0},"esc":{"ability":"dex","rt":false,"acp":true,"rank":0},"fly":{"ability":"dex","rt":false,"acp":true,"rank":0},"han":{"ability":"cha","rt":true,"acp":false,"rank":0},"hea":{"ability":"wis","rt":false,"acp":false,"rank":0},"int":{"ability":"cha","rt":false,"acp":false,"rank":0},"kar":{"ability":"int","rt":true,"acp":false,"rank":0},"kdu":{"ability":"int","rt":true,"acp":false,"rank":0},"ken":{"ability":"int","rt":true,"acp":false,"rank":0},"kge":{"ability":"int","rt":true,"acp":false,"rank":0},"khi":{"ability":"int","rt":true,"acp":false,"rank":0},"klo":{"ability":"int","rt":true,"acp":false,"rank":0},"kna":{"ability":"int","rt":true,"acp":false,"rank":0},"kno":{"ability":"int","rt":true,"acp":false,"rank":0},"kpl":{"ability":"int","rt":true,"acp":false,"rank":0},"kre":{"ability":"int","rt":true,"acp":false,"rank":0},"lin":{"ability":"int","rt":true,"acp":false,"rank":0},"lor":{"ability":"int","rt":true,"acp":false,"rank":0},"per":{"ability":"wis","rt":false,"acp":false,"rank":0},"prf":{"ability":"cha","rt":false,"acp":false,"rank":0},"pro":{"ability":"wis","rt":true,"acp":false,"rank":0},"rid":{"ability":"dex","rt":false,"acp":true,"rank":0},"sen":{"ability":"wis","rt":false,"acp":false,"rank":0},"slt":{"ability":"dex","rt":