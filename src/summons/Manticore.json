{"fort":{"value":"high"},"ref":{"value":"high"},"will":{"value":"low"}},"fc":{"hp":{"value":0},"skill":{"value":0},"alt":{"value":0,"notes":""}},"wealth":"","alignment":"","classSkills":{"acr":true,"clm":true,"fly":true,"per":true,"ste":true,"swm":true}},"type":"class","effects":[],"folder":null,"sort":112500,"flags":{"core":{"sourceId":"Compendium.pf1.racial-hd.Item.AjUleVwKSsSaDI4N"}},"ownership":{"default":0}},{"_id":"e2ou9Qfdx6nNa7WQ","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795126557951,"modifiedTime":1795126561262,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"icons/creatures/abilities/wing-batlike-purple-blue.webp","name":"Flyby Attack","system":{"description":{"value":"<p><em>This creature can make an attack before and after it moves while flying.</em> </p><p><strong>Prerequisites</strong>: Fly speed.</p><p><strong>Benefit</strong>: When flying, the creature can take a move action and another standard action at any point during the move. The creature cannot take a second move action during a round when it makes a flyby attack.</p><p><strong>Normal</strong>: Without this feat, the creature takes a standard action either before or after its move.</p>","instructions":""},"tags":[],"actions":[{"_id":"CVK9o4MhaI5XEA0o","activation":{"type":"special","unchained":{"type":"special","cost":1},"cost":1},"duration":{"units":"inst"},"name":"Use","range":{"units":"seeText"},"actionType":"other","uses":{},"powerAttack":{"damageBonus":2,"critMultiplier":1}}],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1112","pages":"315"}]},"type":"feat","effects":[],"folder":null,"sort":212500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.PlCHtwe6e3f7pZYR"},"pf1":{"migration":"11.11"}},"ownership":{"default":0}},{"_id":"sw7gOi9mBcZizcO9","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795126557993,"modifiedTime":1795126561262,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"icons/commodities/biological/wing-green.webp","name":"Hover","system":{"description":{"value":"<p><em>This creature can hover in place with ease and can kick up clouds of dust and debris.</em></p><p><strong>Prerequisites</strong>: Fly speed.</p><p><strong>Benefits</strong>: A creature with this feat can halt its movement while flying, allowing it to hover without needing to make a Fly skill check.</p><p>If a creature of size Large or larger with this feat hovers within 20 feet of the ground in an area with lots of loose debris, the draft from its wings creates a hemispherical cloud with a radius of 60 feet. The winds generated can snuff torches, small campfires, exposed lanterns, and other small, open flames of non-magical origin. Clear vision within the cloud is limited to 10 feet. Creatures have concealment at 15 to 20 feet (20% miss chance). At 25 feet or more, creatures have total concealment (50% miss chance, and opponents cannot use sight to locate the creature).</p><p><strong>Normal</strong>: Without this feat, a creature must make a Fly skill check to hover and the creature does not create a cloud of debris while hovering.</p>","instructions":""},"tags":["Monster"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFormula":"","rechargeFormula":""},"changes":[],"changeFlags":{"immuneToMorale":false,"loseDexToAC":false,"noMediumEncumbrance":false,"noHeavyEncumbrance":false,"mediumArmorFullSpeed":false,"heavyArmorFullSpeed":false,"lowLightVision":false,"seeInvisibility":false,"seeInDarkness":false},"contextNotes":[],"links":{"children":[],"charges":[],"supplements":[]},"tag":"","armorProf":[],"weaponProf":[],"languages":[],"flags":{"boolean":{},"dictionary":{}},"scriptCalls":[],"subType":"feat","traitType":"","traitCategory":"","racePoints":null,"abilityType":"na","associations":{"classes":[]},"showInQuickbar":false,"crOffset":"","inherited":false,"acquired":false,"simple":false,"summons":false,"disabled":false,"classSkills":{},"sources":[{"id":"PZO1112","pages":"315"}]},"type":"feat","effects":[],"folder":null,"sort":312500,"flags":{"core":{"sourceId":"Compendium.pf1.feats.Item.6lqGh0NvprZpUUwV"}},"ownership":{"default":0}},{"_id":"uLZ5vPYTs1YRugIr","_stats":{"coreVersion":"13.351","systemId":"pf1","systemVersion":"11.11","createdTime":1795126558045,"modifiedTime":1795126561262,"lastModifiedBy":"C7TQ7ZOKBUpwNi2A"},"img":"systems/pf1/icons/feats/weapon-focus.jpg","name":"Weapon Focus (Spikes)","system":{"description":{"value":"<i>Choose one type of weapon. You can also choose unarmed strike or grapple (or ray, if you are a spellcaster) as your weapon for the purposes of this feat.</i><p><strong>Prerequisites</strong>: Proficiency with selected weapon, base attack bonus +1.</p><p><strong>Benefits</strong>: You gain a +1 bonus on all attack rolls you make using the selected weapon.</p><p><strong>Special</strong>: You can gain this feat multiple times. Its effects do not stack. Each time you take the feat, it applies to a new type of weapon.</p>","instructions":""},"tags":["Combat","Weapon","Offensive"],"actions":[],"attackNotes":[],"effectNotes":[],"uses":{"value":null,"per":"","autoDeductChargesCost":"","maxFo